OPENAI_API_KEY=
DEMO_MODE=true
OPENAI_SPRITE_MODEL=gpt-4.1-mini
NEXT_PUBLIC_LEAP_WS_URL=ws://127.0.0.1:6437/v6.json
# Which hand drives the cursor: right (default), left, or any. The first one seen stays
# locked until it leaves the sensor, so a second hand is ignored.
NEXT_PUBLIC_LEAP_HAND=right

# The Python council backend (uvicorn backend.api:app --port 8000). /api/council
# proxies to this server-side, so it's never exposed to the browser.
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DEFAULT_PLAN_LOCATION=Atlanta, GA
# Deepgram voice for the People Maker interview. Server-only (Next API routes); never NEXT_PUBLIC_.
# Leave empty to fall back to the browser's own speech APIs and typed answers.
DEEPGRAM_API_KEY=
# Aura-2 voice for the interviewer (https://developers.deepgram.com/docs/tts-models).
DEEPGRAM_TTS_MODEL=aura-2-luna-en
# Lifetime of the short-lived browser token minted by /api/voice/token (Deepgram max 3600).
DEEPGRAM_TOKEN_TTL_SECONDS=300
# Speech-to-text model for recorded answers (used when the key cannot mint live-stream tokens).
DEEPGRAM_STT_MODEL=nova-3

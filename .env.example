OPENAI_API_KEY=
DEMO_MODE=true
OPENAI_SPRITE_MODEL=gpt-4.1-mini
NEXT_PUBLIC_LEAP_WS_URL=ws://127.0.0.1:6437/v6.json
# Which hand drives the cursor: right (default), left, or any. The first one seen stays
# locked until it leaves the sensor, so a second hand is ignored.
NEXT_PUBLIC_LEAP_HAND=right

# The Python council backend (uvicorn backend.api:app --port 8000). /api/council
# proxies to this server-side, so it's never exposed to the browser.
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DEFAULT_PLAN_LOCATION=Atlanta, GA

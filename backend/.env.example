OPENAI_API_KEY=
DEMO_MODE=true
OPENAI_SPRITE_MODEL=gpt-4.1-mini

# Live offer providers. Keep these values on the Python server; never prefix
# secret keys with NEXT_PUBLIC_. The local provider remains the safe fallback.
AFFINITY_PRODUCT_PROVIDER=local
AFFINITY_PLACE_PROVIDER=local
AFFINITY_EVENT_PROVIDER=local

# Shopify Global Catalog and UCP Cart MCP
SHOPIFY_UCP_CATALOG_ENDPOINT=https://catalog.shopify.com/api/ucp/mcp
SHOPIFY_UCP_AGENT_PROFILE_URL=https://shopify.dev/ucp/agent-profiles/examples/2026-08-25/valid-with-capabilities.json
SHOPIFY_UCP_VERSION=2026-08-25
SHOPIFY_UCP_AUTH_MODE=anonymous
SHOPIFY_UCP_CATALOG_ID=
SHOPIFY_UCP_CLIENT_ID=
SHOPIFY_UCP_CLIENT_SECRET=
SHOPIFY_UCP_SEARCH_LIMIT=8
AFFINITY_SHIPPING_COUNTRY=US
AFFINITY_SHIPPING_POSTAL_CODE=
AFFINITY_CURRENCY=USD

# Google Places API (New), used for restaurants and local activities
# Set AFFINITY_PLACE_PROVIDER=google_places after enabling the API and billing.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_SEARCH_LIMIT=10
GOOGLE_PLACES_REGION_CODE=US

# Post-approval plan email. Use a provider-issued SMTP credential or app
# password, never a normal personal account password.
AFFINITY_EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Affinity
SMTP_REPLY_TO=
SMTP_TIMEOUT_SECONDS=20

# Optional: dated concerts, sports, theatre, and other ticketed events
# Set AFFINITY_EVENT_PROVIDER=ticketmaster to enable it.
TICKETMASTER_API_KEY=

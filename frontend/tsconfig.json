{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "vitest": [
        "./node_modules/vitest"
      ],
      "vitest/*": [
        "./node_modules/vitest/*"
      ],
      "@testing-library/*": [
        "./node_modules/@testing-library/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "three": [
        "./node_modules/@types/three"
      ],
      "three/*": [
        "./node_modules/@types/three/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../leap-bridge",
    "../tests/ui"
  ]
}